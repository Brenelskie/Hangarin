# Copy this file to .env for local development. Never commit the real .env file.
# Production values and the deployment sequence are documented in README.md.
DJANGO_ENV=development
DJANGO_SECRET_KEY=django-insecure-change-this-for-local-development-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_ENABLE_HSTS=False
# Keep False except for a reviewed, empty first production launch.
HANGARIN_ALLOW_PRODUCTION_SEED=False

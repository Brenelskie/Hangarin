# Copy this file to .env for local development. Never commit the real .env file.
DJANGO_ENV=development
DJANGO_SECRET_KEY=django-insecure-change-this-for-local-development-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_ENABLE_HSTS=False
